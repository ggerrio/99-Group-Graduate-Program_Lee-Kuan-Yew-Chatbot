# ==============================================================================
# Lee Kuan Yew AI Chatbot - Environment Configuration (Template)
# ==============================================================================

# 1. API KEYS (WAJIB DIISI)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. APPLICATION & SERVER SETTINGS
APP_NAME="Lee Kuan Yew AI Chatbot"
APP_VERSION=0.4.0
DEBUG=True
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# 3. DATABASE & PERSISTENCE
DATABASE_URL=sqlite:///./lky_chatbot.db

# 4. AI MODEL & RAG CONFIGURATION
GEMINI_MODEL_NAME=gemini-2.5-flash
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
HF_TOKEN=  # Optional Hugging Face User Access Token to avoid unauthenticated hub rate-limits
RETRIEVAL_TOP_K=5
CONTEXT_TOKEN_BUDGET=3000
CHAT_HISTORY_MAX_TURNS=6
SIMILARITY_SCORE_THRESHOLD=0.35

# 5. VECTOR DATABASE (QDRANT)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=lky_knowledge

# 6. INGESTION DIRECTORIES & LIMITS
KNOWLEDGE_DIR=./knowledge
PROCESSED_DIR=./processed
CHUNK_SIZE=750
CHUNK_OVERLAP=150
MAX_FILE_SIZE=52428800

# 7. FRONTEND (VITE) ENVIRONMENT VARIABLES
VITE_API_BASE_URL=http://localhost:8000
